{
  "name": "required-checks",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {"context": "app-cheatsheets"},
          {"context": "app-hexclock"},
          {"context": "app-quotes"},
          {"context": "ci/circleci: pre-commit"},
          {"context": "dependency-review"},
          {"context": "lint"},
          {"context": "quotes-json"},
          {"context": "site"},
          {"context": "site-minify"},
          {"context": "wip"},
          {"context": "www-redir"}
        ]
      }
    }
  ]
}
